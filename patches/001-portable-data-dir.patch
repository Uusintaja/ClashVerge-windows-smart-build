+/// Portable override: the `Data/` folder next to the executable mirrors a
+/// Windows user profile (`Data/Roaming` stands in for `%APPDATA%`). When the
+/// launcher has prepared `Data/Roaming/<APP_ID>/`, keep all app data there
+/// instead of the roaming profile. On Windows `dirs::data_dir()` resolves
+/// through the Known Folder API and ignores process environment overrides,
+/// so an env-only wrapper cannot redirect it; this early return is the hook.
+pub(crate) fn portable_data_root() -> Option<PathBuf> {
+    let exe = std::env::current_exe().ok()?;
+    let root = exe
+        .parent()?
+        .join("Data")
+        .join("Roaming")
+        .join(APP_ID);
+    root.is_dir().then_some(root)
+}
+
 /// Uses the same platform data resolver as Tauri, including before its handle exists.
 pub fn app_home_dir() -> Result<PathBuf> {
+    if let Some(root) = portable_data_root() {
+        return Ok(root);
+    }
     ::dirs::data_dir()
         .map(|root| root.join(APP_ID))
         .ok_or_else(|| anyhow::anyhow!("Failed to get the app home directory"))
 }
 
